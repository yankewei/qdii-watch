{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qdii-watch",
  "main": "worker.ts",
  "compatibility_date": "2026-05-30",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "docs",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "SUBSCRIPTIONS",
      "id": "387eba0542b84caba741ec8b3ea102a9"
    }
  ]
}
